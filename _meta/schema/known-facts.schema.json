{
  "$comment": "Frictionless Table Schema plus x-papiamento extensions read by tools/validate.py. See _meta/conventions.md.",
  "title": "Known facts: rulings the data must always agree with",
  "primaryKey": "id",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "constraints": {
        "required": true,
        "unique": true,
        "pattern": "^fact-[0-9]{4}$"
      }
    },
    {
      "name": "table",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "words",
          "numbers",
          "calendar",
          "barbarismos",
          "variants",
          "loanwords"
        ]
      }
    },
    {
      "name": "where",
      "type": "string",
      "description": "Which rows the fact applies to: field=value pairs joined by &, e.g. lemma=hopi or kind=cardinal&value=23",
      "constraints": {
        "required": true,
        "pattern": "^[a-z_]+=[^&]+(&[a-z_]+=[^&]+)*$"
      }
    },
    {
      "name": "field",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "match",
      "type": "string",
      "description": "equals: whole cell equals value. contains: one of the '; '-separated items equals value (case-insensitive). not-contains: none of them does.",
      "constraints": {
        "required": true,
        "enum": [
          "equals",
          "contains",
          "not-contains"
        ]
      }
    },
    {
      "name": "value",
      "type": "string",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "ruled_by",
      "type": "string",
      "description": "GitHub username of whoever made the ruling",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "date",
      "type": "string",
      "constraints": {
        "required": true,
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      }
    },
    {
      "name": "notes",
      "type": "string"
    }
  ]
}
