{
  "title": "Curaçao (pap-CW) to Aruba (pap-AW) spelling map",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "description": "Stable id, never reused",
      "constraints": {
        "required": true,
        "pattern": "^var-[0-9]{4}$",
        "unique": true
      }
    },
    {
      "name": "curacao",
      "type": "string",
      "description": "Curaçao spelling",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "aruba",
      "type": "string",
      "description": "Aruban spelling",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "pattern",
      "type": "string",
      "description": "Spelling correspondence, e.g. k>c, -shon>-cion"
    },
    {
      "name": "status",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "draft",
          "reviewed",
          "disputed",
          "deprecated"
        ]
      },
      "description": "draft | reviewed | disputed | deprecated"
    },
    {
      "name": "reviewed_by",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Za-z0-9-]+(; [A-Za-z0-9-]+)*$"
      },
      "description": "GitHub usernames of the reviewers, separated by '; '. Required when status is reviewed."
    },
    {
      "name": "source",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Z]{2,5}[0-9]{4}[a-z]?$"
      },
      "description": "Source id from sources/sources.tsv."
    },
    {
      "name": "page",
      "type": "string",
      "constraints": {
        "pattern": "^([0-9]+(-[0-9]+)?|[ivxlc]+(-[ivxlc]+)?)$"
      },
      "description": "Printed page number(s), e.g. 38 or 38-39, roman for front matter."
    },
    {
      "name": "notes",
      "type": "string"
    }
  ],
  "x-papiamento": {
    "unique_together": [
      [
        "curacao",
        "aruba"
      ]
    ],
    "aruban_text": [
      "aruba"
    ],
    "lexicon_refs": [
      "aruba"
    ],
    "contributor_refs": [
      "reviewed_by"
    ]
  },
  "$comment": "Frictionless Table Schema plus x-papiamento extensions read by tools/validate.py. See _meta/conventions.md.",
  "primaryKey": "id",
  "foreignKeys": [
    {
      "fields": "source",
      "reference": {
        "resource": "sources",
        "fields": "id"
      }
    }
  ]
}
