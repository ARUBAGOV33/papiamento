{
  "title": "Barbarismos: wrong form to Aruban form",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "description": "Stable id, never reused",
      "constraints": {
        "required": true,
        "pattern": "^bar-[0-9]{4}$",
        "unique": true
      }
    },
    {
      "name": "wrong",
      "type": "string",
      "description": "The form to avoid, as people write it",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "right",
      "type": "string",
      "description": "The Aruban form to use",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "origin",
      "type": "string",
      "description": "Where the wrong form comes from",
      "constraints": {
        "required": true,
        "enum": [
          "es",
          "nl",
          "en",
          "pt",
          "pap-CW",
          "other"
        ]
      }
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Short explanation in plain language"
    },
    {
      "name": "rule_id",
      "type": "string",
      "description": "Rule that catches it. RULE_LEX_* ids are row-level: the row itself is the rule, so they have no grammar file (grammar/README.md). Any other id must be the id of a grammar file; the validator warns when it is not.",
      "constraints": {
        "pattern": "^RULE_[A-Z]+_[A-Z0-9_]+$"
      }
    },
    {
      "name": "status",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "draft",
          "reviewed",
          "disputed",
          "deprecated"
        ]
      },
      "description": "draft | reviewed | disputed | deprecated"
    },
    {
      "name": "reviewed_by",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Za-z0-9-]+(; [A-Za-z0-9-]+)*$"
      },
      "description": "GitHub usernames of the reviewers, separated by '; '. Required when status is reviewed."
    },
    {
      "name": "source",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Z]{2,5}[0-9]{4}[a-z]?$"
      },
      "description": "Source id from sources/sources.tsv."
    },
    {
      "name": "page",
      "type": "string",
      "constraints": {
        "pattern": "^([0-9]+(-[0-9]+)?|[ivxlc]+(-[ivxlc]+)?)$"
      },
      "description": "Printed page number(s), e.g. 38 or 38-39, roman for front matter."
    },
    {
      "name": "notes",
      "type": "string"
    }
  ],
  "x-papiamento": {
    "unique_together": [
      [
        "wrong",
        "right"
      ]
    ],
    "aruban_text": [
      "right"
    ],
    "lexicon_refs": [],
    "rule_refs": [
      "rule_id"
    ]
  },
  "$comment": "Frictionless Table Schema plus x-papiamento extensions read by tools/validate.py. See _meta/conventions.md.",
  "primaryKey": "id",
  "foreignKeys": [
    {
      "fields": "source",
      "reference": {
        "resource": "sources",
        "fields": "id"
      }
    }
  ]
}
