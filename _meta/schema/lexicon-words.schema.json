{
  "title": "Lexicon: words for one letter",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "description": "Stable id, never reused",
      "constraints": {
        "required": true,
        "pattern": "^pap-[0-9]{6}$",
        "unique": true
      }
    },
    {
      "name": "lemma",
      "type": "string",
      "description": "Headword exactly as the source prints it",
      "constraints": {
        "required": true
      }
    },
    {
      "name": "alt",
      "type": "string",
      "description": "Alternative forms from the source's brackets, '; '-separated"
    },
    {
      "name": "pos",
      "type": "string",
      "description": "Part of speech",
      "constraints": {
        "enum": [
          "s.",
          "v.",
          "adh.",
          "adv.",
          "num.",
          "pron.",
          "prep.",
          "conh.",
          "interh.",
          "art.",
          "expr.",
          "abr."
        ]
      }
    },
    {
      "name": "tag",
      "type": "string",
      "description": "The source's own parenthetical label, verbatim"
    },
    {
      "name": "en",
      "type": "string",
      "description": "English translation(s), '; '-separated"
    },
    {
      "name": "nl",
      "type": "string",
      "description": "Dutch translation(s), '; '-separated"
    },
    {
      "name": "es",
      "type": "string",
      "description": "Spanish translation(s), '; '-separated"
    },
    {
      "name": "translated_by",
      "type": "string",
      "description": "Who wrote the translations in en, nl and es: machine for machine drafts, otherwise GitHub usernames, separated by '; '. Required when any translation is filled.",
      "constraints": {
        "pattern": "^(machine|[A-Za-z0-9-]+)(; (machine|[A-Za-z0-9-]+))*$"
      }
    },
    {
      "name": "status",
      "type": "string",
      "constraints": {
        "required": true,
        "enum": [
          "draft",
          "reviewed",
          "disputed",
          "deprecated"
        ]
      },
      "description": "draft | reviewed | disputed | deprecated"
    },
    {
      "name": "reviewed_by",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Za-z0-9-]+(; [A-Za-z0-9-]+)*$"
      },
      "description": "GitHub usernames of the reviewers, separated by '; '. Required when status is reviewed."
    },
    {
      "name": "source",
      "type": "string",
      "constraints": {
        "pattern": "^[A-Z]{2,5}[0-9]{4}[a-z]?$"
      },
      "description": "Source id from sources/sources.tsv."
    },
    {
      "name": "page",
      "type": "string",
      "constraints": {
        "pattern": "^([0-9]+(-[0-9]+)?|[ivxlc]+(-[ivxlc]+)?)$"
      },
      "description": "Printed page number(s), e.g. 38 or 38-39, roman for front matter."
    },
    {
      "name": "notes",
      "type": "string"
    }
  ],
  "x-papiamento": {
    "unique_together": [
      [
        "lemma",
        "pos",
        "tag"
      ]
    ],
    "sort_by": [
      "lemma",
      "pos",
      "tag",
      "id"
    ],
    "aruban_text": [
      "lemma",
      "alt"
    ],
    "letter_folder": "lemma",
    "required_if_any": {
      "translated_by": [
        "en",
        "nl",
        "es"
      ]
    }
  },
  "$comment": "Frictionless Table Schema plus x-papiamento extensions read by tools/validate.py. See _meta/conventions.md.",
  "primaryKey": "id",
  "foreignKeys": [
    {
      "fields": "source",
      "reference": {
        "resource": "sources",
        "fields": "id"
      }
    }
  ]
}
